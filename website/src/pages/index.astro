---
import Base from "../layouts/Base.astro";
import Landing from "../components/Landing.astro";
import type { LandingStrings } from "../components/Landing.astro";

const t: LandingStrings = {
  h1a: "AI agents.",
  h1b: "Under your command.",
  lede:
    "Contenox is built for demanding work — and the people accountable for it.",
  ctaPrimary: "Quickstart",
  ctaGithub: "View on GitHub",
  copyLabel: "Copy",
  installTabPosix: "macOS / Linux",
  installTabWindows: "Windows",
  installNote:
    'Installs <code class="font-mono">contenox</code>. Run <code class="font-mono">contenox auto</code> to detect your hardware, download a model, and open the terminal.',
  startFree:
    "No account required. Local, private, and hosted models can work side by side.",
  trustChips: [
    "operator-controlled",
    "model-independent",
    "no account",
    "open source",
  ],

  shapesEyebrow: "The work",
  shapesH2: "One standard. However you work.",
  shapesLede:
    "At the keyboard, inside the editor, or running without you: the same work, context, and controls carry through.",
  shapes: [
    [
      "contenox beam",
      "The Interactive Terminal",
      "Full-screen, native scrollback, / for commands, and @ to put a file in front of the agent. A gated call raises an approval card answered with one keystroke. Bare contenox opens it.",
      "/docs/guide/quickstart/",
    ],
    [
      "contenox acp",
      "The Editor Integration",
      "The same agent over stdio to Zed, JetBrains, AionUi, OpenClaw and any client speaking the Agent Client Protocol. The editor owns your workspace and permission UI.",
      "/docs/integrations/acp/",
    ],
    [
      "contenox run",
      "The Automation Engine",
      "Headless batch execution for CI/CD pipelines, cron jobs, and unattended scripts. Runs tasks with tools on that machine and exits 0 when the work lands.",
      "/docs/reference/contenox-cli/",
    ],
  ],
  tuiDemoAlt:
    "Terminal recording: contenox beam running a session, with a gated command answered by one keystroke",
  tuiDemoPlay: "Play the Contenox terminal demo",
  tuiDemoCaption:
    "Beam reviews a local change with a model running on this machine.",
  guides: [
    ["Start in the terminal", "/docs/guide/quickstart/"],
    ["Declaring agents", "/docs/guide/declarations/"],
    ["The approval model", "/docs/guide/hitl/"],
    ["Agent Client Protocol", "/docs/integrations/acp/"],
  ],

  toolsEyebrow: "Capability",
  toolsH2: "The systems behind the work.",
  toolsLede:
    "Code is only one part of real work. Contenox reaches the systems it needs without surrendering the boundaries around them.",
  toolsWays: [
    [
      "Declared per agent",
      "Tools are passed to agents explicitly in their Markdown declarations (tools: Read, Glob, Grep, or *). Enforcing narrow toolsets prevents confusing the model with unused tool descriptions.",
    ],
    [
      "Added via CLI or MCP",
      "Connect any Model Context Protocol (MCP) server or wrap internal HTTP APIs via OpenAPI specs. Declarations can also declare private, agent-scoped MCP servers.",
    ],
  ],
  toolsNote:
    "Every call crosses one boundary and is checked against your policy envelope before it runs.",
  toolsCtas: [
    ["Declaring agents", "/docs/guide/declarations/"],
    ["Connect an MCP server", "/docs/integrations/tools/mcp/"],
    ["Wrap an HTTP API", "/docs/integrations/tools/remote/"],
  ],

  yoursEyebrow: "Command",
  yoursH2: "Nothing important is left implicit.",
  yoursPoints: [
    [
      "Fail-closed envelopes",
      "Every run is bounded by an envelope: a JSON policy naming what passes silently, what stops for a human, and what is denied outright, plus hard ceilings on tool calls and tokens. Anything no rule matches fails closed.",
    ],
    [
      "Durable checkpointing",
      "A run that stops for a person checkpoints where it stopped, saves the ask, and releases the process. Restart the box, close the laptop, let days pass: when the answer arrives the run resumes from that exact point, exactly once.",
    ],
    [
      "Landlock confinement",
      "The Linux Landlock sandbox confines foreign agent code locally with scrubbed environments and filesystem confinement.",
    ],
    [
      "One operation, every model",
      "Run native inference through modeld, connect Ollama or vLLM, and add hosted providers with your own keys — side by side, under the same policies and execution state.",
    ],
  ],
  yoursCta: ["How envelopes & approvals work", "/docs/guide/hitl/"],

  bottomEyebrow: "Contenox",
  bottomH2: "Put it to work.",
  bottomCta: "Read the Quickstart",
  bottomContact:
    'Questions? <a href="mailto:hello@contenox.com" class="underline hover:text-black dark:hover:text-white">hello@contenox.com</a> · Issues and PRs on <a href="https://github.com/contenox/contenox" class="underline hover:text-black dark:hover:text-white">GitHub</a>',
  builtOnEyebrow: "Built on",
  builtOnNote:
    "SQLite is the zero-dependency default. PostgreSQL, NATS, and Valkey form the server-backed deployment.",
  builtOn: [
    ["Go", "the implementation", "https://go.dev"],
    ["modeld", "local inference", "/docs/integrations/providers/modeld/"],
    ["llama.cpp", "inference backend", "https://github.com/ggml-org/llama.cpp"],
    ["OpenVINO", "inference backend", "https://github.com/openvinotoolkit/openvino.genai"],
    ["SQLite", "default state", "https://sqlite.org"],
    ["PostgreSQL", "server state", "https://www.postgresql.org"],
    ["NATS", "server messaging", "https://nats.io"],
    ["Valkey", "server cache", "https://valkey.io"],
  ],
  sponsorNote:
    'The Contenox Project is 100% Fair & Open Source under the <a href="https://github.com/contenox/contenox/blob/main/LICENSE" class="underline hover:text-black dark:hover:text-white">Apache-2.0 License</a>.',
};
---

<Base
  title="Contenox — AI agents under your command"
  description="Contenox is built for demanding agentic work across local and hosted models, existing systems, and infrastructure you control."
  alternates={{ en: "/", de: "/de/" }}
>
  <Landing t={t} />
</Base>

---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import type { LandingStrings } from '../components/Landing.astro';

const t: LandingStrings = {
  badge: 'An open coding harness',
  h1a: 'One harness.',
  h1b: 'Any model. Any editor.',
  lede: 'Chat, plan, and shell in your terminal — and the same agent inside Zed, JetBrains, or any ACP client. Fire off missions that run unattended inside an approval envelope, wire in your tools, and pick your models freely, from Ollama to OpenAI. No account, no hosted service.',
  ctaRecipe: 'Run a recipe',
  ctaPackage: 'Package a workflow',
  ctaGithub: 'View on GitHub',
  installNote: 'Installs <code class="font-mono">contenox</code>. Run <code class="font-mono">contenox init</code> to scaffold a workspace.',
  positioning: 'Contenox is a bet on what coding agents become next: delegated instead of babysat, model-agnostic instead of subscribed, everywhere you work instead of bolted onto one editor. The harness — sessions, tools, approvals, missions — stays yours while models come and go.',
  tableWorld: 'Coding agents today',
  tableWhy: 'The bet Contenox makes',
  rows: [
    ['You watch the agent work and approve it token by token.', 'You fire a mission and stay in flow — the envelope decides when you get interrupted.'],
    ['The agent is a subscription to one vendor’s model.', 'Models are config: local Ollama or vLLM today, a frontier API tomorrow, without changing how you work.'],
    ['Every editor ships its own copilot with its own memory.', 'One agent and one session memory across the terminal and every ACP editor.'],
    ['Your best prompts and guardrails die in chat scrollback.', 'Repeatable work lives in versioned chains — reviewable, shareable, runnable anywhere.'],
  ],
  authorEyebrow: 'What you can author',
  authorH2: 'Repeatable work, with policy in the file.',
  authorItems: [
    'Release evidence pack: feed in git history, PRs, ticket notes, and CI output; the chain drafts the changelog, risk notes, and deployment checklist, then stops before publishing.',
    'API-to-workflow wrapper: register a narrow OpenAPI subset, inject hidden workspace or environment arguments, and require approval for mutating calls.',
    'Repo maintenance chain: inspect an issue, plan the patch, touch only approved files, run tests, and prepare a review packet instead of silently changing the project.',
    'Browser QA evidence: Playwright captures the live app state, the chain writes documentation or screenshots, and the policy decides what needs human approval.',
  ],
  editorsEyebrow: 'Run it where work happens',
  editorsH2: 'The same chain can run in your editor, terminal, or automation.',
  editorsLede: 'Contenox speaks the Agent Client Protocol over stdio. Use Zed, JetBrains, AionUi, or OpenClaw when an editor UI helps; keep the workflow itself in the chain file, with tool calls and HITL approvals routed through the client.',
  guides: [
    ['Read the Zed guide', '/docs/integrations/editors/zed/'],
    ['Read the JetBrains guide', '/docs/integrations/editors/jetbrains/'],
    ['Read the AionUi guide', '/docs/integrations/editors/aionui/'],
    ['Read the OpenClaw guide', '/docs/integrations/editors/openclaw/'],
  ],
  capsEyebrow: 'Core capabilities',
  caps: [
    ['The Chain is the contract', 'Prompts, model routing, tool allowlists, command policy, budgets, and approval gates are visible keys in a versioned file — reviewable, diffable, repeatable.'],
    ['Runs where work happens', 'One harness behind the CLI, the beam TUI, and any ACP editor. Same chains, same sessions, same policy everywhere.'],
    ['Providers are config', 'Route inference to local Ollama or vLLM, or to OpenAI, Anthropic, Mistral, Gemini, OpenRouter, Bedrock, or Vertex — without touching the workflow.'],
    ['Local by default', 'Sessions, config, run logs, and state live in SQLite on your machine. No hosted Contenox service, no account — telemetry is opt-in and off by default.'],
  ],
  hitlDemoAlt: 'Terminal demo: a destructive rm command stops at a human approval gate before it runs',
  tuiShotAlt: 'contenox beam in the terminal: a natural-language task, contenox reads the repo and answers in the same session',
  tuiEyebrow: 'The terminal UI',
  tuiH2: 'One session. Chat, plan, shell.',
  tuiLede: 'contenox beam opens a persistent terminal session where conversation, plans, and shell commands share one context — and MCP tool connections stay alive across turns instead of reconnecting on every call.',
  tuiPoints: [
    ['Chat, plan, and run in one place', 'Talk through the problem, sketch the plan, execute the commands — without switching windows or losing context between modes.'],
    ['MCP stays warm', 'Tool servers connect once and stay connected across turns, so stateful tools keep their state and answers come back fast.'],
    ['Approvals that stay out of the way', 'Risky steps pause for a quick yes or no right in the session — sensible defaults, no ceremony.'],
  ],
  tuiCta: 'Explore the contenox CLI',
  standardsEyebrow: 'Built on open standards',
  standardsH2: 'Speaks the protocols your tools already use.',
  standards: [
    ['Agent Client Protocol', 'The full agent inside Zed, JetBrains, AionUi, and any ACP client — over stdio, no plugin lock-in.', 'https://agentclientprotocol.com'],
    ['Model Context Protocol', 'Register any MCP server — stdio, SSE, or HTTP — and its tools become policy-scoped chain tools.', 'https://modelcontextprotocol.io'],
    ['OpenAPI', 'Point at any HTTP service with a spec and every operation becomes a callable, allowlistable tool.', '/docs/integrations/tools/remote/'],
  ],
  bottomEyebrow: 'Get started',
  bottomH2: 'Up and running in the next five minutes.',
  bottomCta: 'Read the Quickstart',
  bottomContact: 'Questions? <a href="mailto:hello@contenox.com" class="underline hover:text-black dark:hover:text-white">hello@contenox.com</a> · Issues and PRs on <a href="https://github.com/contenox/runtime" class="underline hover:text-black dark:hover:text-white">GitHub</a>',
  builtOnEyebrow: 'Built on',
  builtOnNote: 'Local models connect through Ollama or vLLM over their local APIs; hosted providers over their public APIs. No bundled inference runtime, no GPU drivers to ship.',
  builtOn: [
    ['Go', 'the implementation', 'https://go.dev'],
    ['SQLite', 'local state', 'https://sqlite.org'],
    ['Ollama', 'local models', 'https://ollama.com'],
    ['vLLM', 'local models', 'https://github.com/vllm-project/vllm'],
  ],
};
---
<Base
  title="Contenox - An open coding harness for terminal and ACP editors"
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>

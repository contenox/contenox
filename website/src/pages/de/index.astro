---
import Base from "../../layouts/Base.astro";
import Landing from "../../components/Landing.astro";
import type { LandingStrings } from "../../components/Landing.astro";

const t: LandingStrings = {
  h1a: "KI-Agenten.",
  h1b: "Unter deinem Kommando.",
  lede:
    "Contenox ist für anspruchsvolle Arbeit gebaut – und für die Menschen, die dafür geradestehen.",
  ctaPrimary: "Quickstart",
  ctaGithub: "Auf GitHub ansehen",
  copyLabel: "Kopieren",
  installTabPosix: "macOS / Linux",
  installTabWindows: "Windows",
  installNote:
    'Installiert <code class="font-mono">contenox</code>. Starte <code class="font-mono">contenox auto</code>, um Hardware zu erkennen, ein Modell zu laden und das Terminal zu öffnen.',
  startFree:
    "Kein Konto erforderlich. Lokale, private und gehostete Modelle arbeiten Seite an Seite.",
  trustChips: [
    "unter deiner Kontrolle",
    "modellunabhängig",
    "kein Konto",
    "Open Source",
  ],

  shapesEyebrow: "Die Arbeit",
  shapesH2: "Ein Anspruch. Jede Arbeitsweise.",
  shapesLede:
    "Am Terminal, im Editor oder ohne dich im Hintergrund: Arbeit, Kontext und Kontrolle bleiben dieselben.",
  shapes: [
    [
      "contenox beam",
      "Das interaktive Terminal",
      "Vollbild, nativer Scrollback, / für Kommandos und @ um Dateien zu übergeben. Eine gegatete Aktion zeigt eine Genehmigungskarte, die mit einem Tastendruck beantwortet wird. Bare contenox startet es.",
      "/docs/guide/quickstart/",
    ],
    [
      "contenox acp",
      "Die Editor-Integration",
      "Derselbe Agent über stdio für Zed, JetBrains, AionUi, OpenClaw und alle ACP-Clients. Der Editor behält Workspace- und Freigabeverwaltung.",
      "/docs/integrations/acp/",
    ],
    [
      "contenox run",
      "Die Automations-Engine",
      "Headless-Batch-Ausführung für CI/CD-Pipelines, Cron-Jobs und unbeaufsichtigte Skripte. Führt Aufgaben mit lokalen Tools aus und beendet mit Exit-Code 0 bei Erfolg.",
      "/docs/reference/contenox-cli/",
    ],
  ],
  tuiDemoAlt:
    "Terminal-Aufzeichnung: eine contenox-beam-Sitzung, in der ein gegatetes Kommando mit einem Tastendruck beantwortet wird",
  tuiDemoPlay: "Contenox-Terminaldemo abspielen",
  tuiDemoCaption:
    "Beam prüft eine lokale Änderung mit einem Modell auf diesem Rechner.",
  guides: [
    ["Im Terminal anfangen", "/docs/guide/quickstart/"],
    ["Agenten deklarieren", "/docs/guide/declarations/"],
    ["Das Freigabe-Modell", "/docs/guide/hitl/"],
    ["Agent Client Protocol", "/docs/integrations/acp/"],
  ],

  toolsEyebrow: "Fähigkeit",
  toolsH2: "Die Systeme hinter der Arbeit.",
  toolsLede:
    "Code ist nur ein Teil echter Arbeit. Contenox erreicht die nötigen Systeme, ohne ihre Grenzen preiszugeben.",
  toolsWays: [
    [
      "Pro Agent deklariert",
      "Tools werden Agenten explizit in ihren Markdown-Deklarationen übergeben (tools: Read, Glob, Grep oder *). Das schützt das Modell vor unnötigen Tool-Beschreibungen.",
    ],
    [
      "Via CLI oder MCP angebunden",
      "Verbinde beliebige Model Context Protocol (MCP) Server oder interne HTTP-APIs via OpenAPI. Deklarationen können auch private, agentenspezifische MCP-Server definieren.",
    ],
  ],
  toolsNote:
    "Jeder Aufruf passiert eine einzige Grenze und wird vor der Ausführung gegen deine Policy geprüft.",
  toolsCtas: [
    ["Agenten deklarieren", "/docs/guide/declarations/"],
    ["MCP-Server anbinden", "/docs/integrations/tools/mcp/"],
    ["HTTP-APIs via OpenAPI", "/docs/integrations/tools/remote/"],
  ],

  yoursEyebrow: "Kommando",
  yoursH2: "Entscheidendes bleibt nie implizit.",
  yoursPoints: [
    [
      "Fail-closed Envelopes",
      "Jeder Run wird durch ein Envelope begrenzt: eine JSON-Policy für erlaubte, genehmigungspflichtige und gesperrte Aktionen mit harten Limits. Unbekanntes stoppt sicher (fail-closed).",
    ],
    [
      "Dauerhaftes Checkpointing",
      "Ein Run, der auf Freigabe wartet, sichert den Stand und gibt den Prozess frei. Starte den Rechner neu, klappe den Laptop zu, lass Tage vergehen: trifft die Antwort ein, setzt der Run genau einmal an der Stelle fort.",
    ],
    [
      "Landlock Sandbox",
      "Die Linux Landlock Sandbox isoliert fremden Agenten-Code lokal mit bereinigter Umgebung und Dateisystem-Eingrenzung.",
    ],
    [
      "Ein Betrieb, alle Modelle",
      "Nutze native Inferenz über modeld, verbinde Ollama oder vLLM und ergänze gehostete Provider mit eigenen Schlüsseln – Seite an Seite, unter denselben Regeln und im selben Ausführungszustand.",
    ],
  ],
  yoursCta: ["KI-Souveränität & KI-Verordnung", "/de/ki-souveraenitaet/"],

  bottomEyebrow: "Contenox",
  bottomH2: "An die Arbeit.",
  bottomCta: "Quickstart lesen",
  bottomContact:
    'Fragen? <a href="mailto:hello@contenox.com" class="underline hover:text-black dark:hover:text-white">hello@contenox.com</a> · Issues und PRs auf <a href="https://github.com/contenox/contenox" class="underline hover:text-black dark:hover:text-white">GitHub</a>',
  builtOnEyebrow: "Baut auf",
  builtOnNote:
    "SQLite ist der Standard ohne externe Abhängigkeiten. PostgreSQL, NATS und Valkey bilden die servergestützte Betriebsform.",
  builtOn: [
    ["Go", "die Implementierung", "https://go.dev"],
    ["modeld", "lokale Inferenz", "/docs/integrations/providers/modeld/"],
    ["llama.cpp", "Inferenz-Backend", "https://github.com/ggml-org/llama.cpp"],
    ["OpenVINO", "Inferenz-Backend", "https://github.com/openvinotoolkit/openvino.genai"],
    ["SQLite", "Standard-Zustand", "https://sqlite.org"],
    ["PostgreSQL", "Server-Zustand", "https://www.postgresql.org"],
    ["NATS", "Server-Nachrichten", "https://nats.io"],
    ["Valkey", "Server-Cache", "https://valkey.io"],
  ],
  sponsorNote:
    'Contenox ist ein 100% freies Open-Source-Projekt unter der <a href="https://github.com/contenox/contenox/blob/main/LICENSE" class="underline hover:text-black dark:hover:text-white">Apache-2.0 Lizenz</a>.',
};
---

<Base
  title="Contenox — KI-Agenten unter deinem Kommando"
  description="Contenox ist für anspruchsvolle agentische Arbeit gebaut – mit lokalen und gehosteten Modellen, bestehenden Systemen und Infrastruktur unter deiner Kontrolle."
  lang="de"
  alternates={{ en: "/", de: "/de/" }}
>
  <Landing t={t} />
</Base>

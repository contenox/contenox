---
export interface LandingStrings {
  announcement?: string;
  announcementHref?: string;
  h1a: string;
  h1b: string;
  lede: string;
  ctaPrimary: string;
  ctaGithub: string;
  copyLabel: string;
  /** OS tab labels on the install command. */
  installTabPosix: string;
  installTabWindows: string;
  installNote: string;
  /** One line under the install: what "free" means here. */
  startFree: string;
  trustChips: string[];

  shapesEyebrow: string;
  shapesH2: string;
  shapesLede: string;
  /** [edition, headline, body, href] — the three ways to run. */
  shapes: [string, string, string, string][];
  tuiDemoAlt: string;
  tuiDemoPlay: string;
  tuiDemoCaption: string;
  guides: [string, string][];

  toolsEyebrow: string;
  toolsH2: string;
  toolsLede: string;
  /** [title, body] — the two ways a tool reaches an agent. */
  toolsWays: [string, string][];
  toolsNote: string;
  /** [label, href] — protocol and tool references. */
  toolsCtas: [string, string][];

  yoursEyebrow: string;
  yoursH2: string;
  /** [title, body] — the four guardrails and confinement guarantees. */
  yoursPoints: [string, string][];
  yoursCta: [string, string];

  bottomEyebrow: string;
  bottomH2: string;
  bottomCta: string;
  bottomContact: string;
  builtOnEyebrow: string;
  builtOnNote?: string;
  builtOn: [string, string, string][];
  sponsorNote?: string;
}

interface Props {
  t: LandingStrings;
}
import InstallCommand from './InstallCommand.astro';
const { t } = Astro.props;
// Large media (gifs, screenshots) is served from the website's S3 bucket.
const media = 'https://contenox-website-assets-573643652148.s3.amazonaws.com/media/';
const card = 'node-card border p-5';
const btnGhost = 'node-button node-button-ghost px-4 py-2 text-sm font-semibold';
const ctaLink = 'node-link font-semibold';
---
<div class="landing-node">
<section class="node-hero hero-grid border-b">
  <div class="grid gap-10 min-w-0 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14">
    <div class="min-w-0">
    {t.announcement && (
      <div class="node-announcement mb-6 inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 border px-3.5 py-1.5 text-xs leading-normal">
        <span class="font-medium">{t.announcement}</span>
        {t.announcementHref && <a href={t.announcementHref} class="text-neutral-400 hover:underline dark:text-neutral-500">&middot; Release notes &rarr;</a>}
      </div>
    )}
    <h1 class="node-title font-bold tracking-tight">
      {t.h1a}
      <span class="text-neutral-500 dark:text-neutral-400">{t.h1b}</span>
    </h1>
    <p class="node-lede mt-6 max-w-xl">{t.lede}</p>
    <div class="node-actions mt-8 flex flex-wrap gap-3">
      <a href="/docs/guide/quickstart/" class="node-button node-button-primary px-4 py-2 text-sm font-semibold">{t.ctaPrimary}</a>
      <a href="https://github.com/contenox/contenox" class={btnGhost}>{t.ctaGithub}</a>
    </div>
    </div>
    <div class="flex h-full min-w-0 flex-col">
      <div class="node-install">
        <InstallCommand posixLabel={t.installTabPosix} windowsLabel={t.installTabWindows} copyLabel={t.copyLabel} />
      </div>
      <p class="mt-3 text-xs text-neutral-500" set:html={t.installNote} />
      <p class="mt-2 text-xs text-neutral-500">{t.startFree}</p>
      <img
        src="/phyllobates-terribilis.webp"
        alt=""
        aria-hidden="true"
        class="node-frog hidden lg:block"
      />
    </div>
  </div>
  <div class="node-demo node-hero-demo relative bg-neutral-950" data-hero-demo>
    <video
      data-hero-video
      muted
      playsinline
      preload="metadata"
      poster={`${media}beam-hero-v6-poster.webp`}
      aria-label={t.tuiDemoAlt}
      class="block h-auto w-full"
    >
      <source src={`${media}beam-hero-v6.webm`} type="video/webm" />
      <source src={`${media}beam-hero-v6.mp4`} type="video/mp4" />
    </video>
    <button
      type="button"
      data-hero-play
      aria-label={t.tuiDemoPlay}
      class="absolute inset-0 flex items-center justify-center bg-black/15 transition-colors hover:bg-black/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#f2c94c]"
    >
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[#f2c94c] text-neutral-950 shadow-lg transition-transform hover:scale-105" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </button>
  </div>
  <p class="node-caption mt-3 text-xs text-neutral-500">{t.tuiDemoCaption}</p>
  <div class="node-trust mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t pt-6">
    <div class="node-chips flex max-w-xl flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral-500">
      {t.trustChips.map((chip, i) => (
        <>
          {i > 0 && <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">&middot;</span>}
          <span>{chip}</span>
        </>
      ))}
    </div>
    <div class="node-badges flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-md border border-neutral-200 bg-neutral-50 px-2.5 py-0.5 font-mono text-[11px] font-medium text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">100% Fair & Open Source</span>
      <span class="rounded-md border border-neutral-200 bg-neutral-50 px-2.5 py-0.5 font-mono text-[11px] font-medium text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">Apache-2.0</span>
      <a href="https://github.com/contenox/contenox/releases" class="inline-flex items-center">
        <img src="https://img.shields.io/github/v/release/contenox/contenox?label=release&color=444" alt="Latest release" loading="lazy" />
      </a>
    </div>
  </div>
</section>

<section class="node-section border-b px-5 py-16">
  <p class="node-kicker text-xs font-semibold tracking-widest uppercase">{t.shapesEyebrow}</p>
  <h2 class="node-heading mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{t.shapesH2}</h2>
  <p class="node-section-lede mt-6 max-w-2xl">{t.shapesLede}</p>
  <div class="node-card-grid mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {t.shapes.map(([edition, headline, body, href]) => (
      <div class={`${card} flex flex-col justify-between text-left`}>
        <div>
          <div class="inline-block rounded-xs border border-neutral-300 bg-neutral-100/80 px-2 py-0.5 font-mono text-[11px] font-semibold text-neutral-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
            {edition}
          </div>
          <h3 class="mt-3 text-base font-bold tracking-tight">{headline}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{body}</p>
        </div>
        {href && (
          <div class="mt-4 pt-3 border-t border-neutral-200/60 dark:border-neutral-800/80 text-xs">
            <a href={href} class={ctaLink}>Documentation &rarr;</a>
          </div>
        )}
      </div>
    ))}
  </div>
  <div class="node-guide-links mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    {t.guides.map(([label, href]) => (
      <a href={href} class="text-neutral-600 hover:text-black dark:text-neutral-400 dark:hover:text-white">{label} →</a>
    ))}
  </div>
</section>

<section class="node-section border-b px-5 py-16">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12 items-start">
    <div class="lg:col-span-5">
      <p class="node-kicker text-xs font-semibold tracking-widest uppercase">{t.toolsEyebrow}</p>
      <h2 class="node-heading mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{t.toolsH2}</h2>
      <p class="node-section-lede mt-6">{t.toolsLede}</p>
      <p class="mt-4 text-sm text-neutral-500">{t.toolsNote}</p>
      <div class="node-guide-links mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {t.toolsCtas.map(([label, href]) => (
          <a href={href} class={ctaLink}>{label} →</a>
        ))}
      </div>
    </div>
    <div class="lg:col-span-7 grid gap-4 sm:grid-cols-2">
      {t.toolsWays.map(([title, body], i) => (
        <div class={`${card} flex flex-col justify-start text-left`}>
          <div class="font-mono text-xs font-semibold text-neutral-400 dark:text-neutral-600">
            0{i + 1}
          </div>
          <h3 class="mt-2 font-bold text-base tracking-tight">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="node-section border-b px-5 py-16">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <p class="node-kicker text-xs font-semibold tracking-widest uppercase">{t.yoursEyebrow}</p>
      <h2 class="node-heading mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{t.yoursH2}</h2>
    </div>
    <div class="text-sm shrink-0">
      <a href={t.yoursCta[1]} class={ctaLink}>{t.yoursCta[0]} →</a>
    </div>
  </div>
  <div class="node-card-grid mt-8 grid gap-4 sm:grid-cols-2">
    {t.yoursPoints.map(([title, body], i) => (
      <div class={`${card} flex flex-col justify-start text-left`}>
        <div class="flex items-center gap-2 font-mono text-xs font-semibold text-neutral-400 dark:text-neutral-600">
          <span>0{i + 1}</span>
          <span class="text-neutral-300 dark:text-neutral-700">/</span>
          <span class="text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">{title}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{body}</p>
      </div>
    ))}
  </div>
</section>

<section class="node-section node-final hero-grid border-t px-5 py-16">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14 items-start">
    <div class="lg:col-span-5">
      <p class="node-kicker text-xs font-semibold tracking-widest uppercase">{t.bottomEyebrow}</p>
      <h2 class="node-heading mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{t.bottomH2}</h2>
      <div class="node-actions mt-6 flex flex-wrap gap-3">
        <a href="/docs/guide/quickstart/" class="node-button node-button-primary px-4 py-2 text-sm font-semibold">{t.bottomCta}</a>
        <a href="https://github.com/contenox/contenox" class={btnGhost}>{t.ctaGithub}</a>
      </div>
      <p class="mt-6 text-sm text-neutral-500" set:html={t.bottomContact} />
    </div>

    <div class="lg:col-span-7">
      <p class="text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.builtOnEyebrow}</p>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {t.builtOn.map(([name, role, href]) => (
          <a href={href} rel="noopener noreferrer" class="node-card border p-3 block no-underline transition-colors hover:border-neutral-400 dark:hover:border-neutral-600">
            <span class="block font-semibold text-sm text-neutral-800 dark:text-neutral-200">{name}</span>
            <span class="block mt-0.5 text-xs text-neutral-500">{role}</span>
          </a>
        ))}
      </div>
      {t.builtOnNote && <p class="mt-4 text-xs text-neutral-500">{t.builtOnNote}</p>}
      {t.sponsorNote && (
        <p class="mt-4 text-xs text-neutral-400 dark:text-neutral-600" set:html={t.sponsorNote} />
      )}
    </div>
  </div>

  <div class="mt-12 flex justify-center pointer-events-none select-none overflow-hidden">
    <img src="/logo-wide-colored-light.svg" alt="" aria-hidden="true" class="w-full max-w-xl opacity-25 dark:hidden" />
    <img src="/logo-wide-colored-dark.svg" alt="" aria-hidden="true" class="hidden w-full max-w-xl opacity-25 dark:block" />
  </div>
</section>
</div>

<style>
  [data-hero-play][hidden] {
    display: none;
  }
</style>

<script>
  document.querySelectorAll('[data-hero-demo]').forEach((demo) => {
    const video = demo.querySelector('video');
    const play = demo.querySelector('button');
    if (!(video instanceof HTMLVideoElement) || !(play instanceof HTMLButtonElement)) return;

    play.addEventListener('click', async () => {
      play.hidden = true;
      try {
        await video.play();
      } catch {
        play.hidden = false;
      }
    });

    video.addEventListener('ended', () => {
      video.load();
      play.hidden = false;
    });
  });
</script>
